{
  "name": "smart-automation-root",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Automation Platform - Autonomous AI Workflow Studio (Monorepo)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix server run build",
    "start": "node server/dist/server.js",
    "start:server": "node server/dist/server.js",
    "start:client": "npm --prefix client run preview"
  },
  "keywords": ["ai", "automation", "gemini", "supabase", "reactflow"]
}
