{
  "name": "smart-automation-root",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Automation Platform - Autonomous AI Workflow Studio (Monorepo)",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
